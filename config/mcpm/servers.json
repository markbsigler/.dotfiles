{
  "vscode-mcp": {
    "name": "vscode-mcp",
    "profile_tags": [
      "default"
    ],
    "enabled": null,
    "command": "npx",
    "args": [
      "vscode-mcp-server"
    ],
    "env": {}
  },
  "filesystem": {
    "name": "filesystem",
    "profile_tags": [
      "default"
    ],
    "enabled": null,
    "command": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-filesystem",
      "/Users/msigler"
    ],
    "env": {}
  },
  "memory": {
    "name": "memory",
    "profile_tags": [
      "default"
    ],
    "enabled": null,
    "command": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-memory"
    ],
    "env": {}
  },
  "sequential-thinking": {
    "name": "sequential-thinking",
    "profile_tags": [
      "default"
    ],
    "enabled": null,
    "command": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-sequential-thinking"
    ],
    "env": {}
  },
  "context7": {
    "name": "context7",
    "profile_tags": [
      "default"
    ],
    "enabled": null,
    "command": "npx",
    "args": [
      "-y",
      "@upstash/context7-mcp@latest"
    ],
    "env": {}
  },
  "git": {
    "name": "git",
    "profile_tags": [
      "default"
    ],
    "enabled": null,
    "command": "uvx",
    "args": [
      "mcp-server-git",
      "--repository",
      ""
    ],
    "env": {}
  },
  "atlassian": {
    "name": "atlassian",
    "profile_tags": [
      "default"
    ],
    "enabled": null,
    "command": "/bin/zsh",
    "args": [
      "-lc",
      "$HOME/.local/bin/mcpm-atlassian-secure"
    ],
    "env": {
      "JIRA_URL": "https://jira.zeng.bmc.com",
      "ATL_MCP_JIRA_TOKEN_SERVICE": "atl_mcp_jira_token",
      "TOOLSETS": "all"
    }
  },
  "apple-mcp": {
    "name": "apple-mcp",
    "profile_tags": [
      "default"
    ],
    "enabled": null,
    "command": "npx",
    "args": [
      "@dhravya/apple-mcp@latest"
    ],
    "env": {}
  },
  "aha-mcp": {
    "name": "aha-mcp",
    "profile_tags": [
      "default"
    ],
    "enabled": null,
    "command": "/bin/zsh",
    "args": [
      "-lc",
      "$HOME/.local/bin/mcpm-aha-secure"
    ],
    "env": {
      "AHA_DOMAIN": "bmc",
      "AHA_MCP_TOKEN_SERVICE": "aha_mcp_token"
    }
  },
  "markitdown": {
    "name": "markitdown",
    "profile_tags": [
      "default"
    ],
    "enabled": null,
    "command": "uvx",
    "args": [
      "markitdown-mcp"
    ],
    "env": {}
  },
  "fetch": {
    "name": "fetch",
    "profile_tags": [
      "default"
    ],
    "enabled": null,
    "command": "uvx",
    "args": [
      "--with",
      "mcp<2.0.0",
      "mcp-server-fetch"
    ],
    "env": {}
  }
}